rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userDoc(uid) {
      return get(/databases/$(database)/documents/users/$(uid));
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return signedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        userDoc(request.auth.uid).data.role == 'admin';
    }

    function isBootstrapAdminProfile() {
      return signedIn() &&
        request.auth.token.email == 'admin@gmail.com' &&
        request.resource.data.role == 'admin';
    }

    function isUserProfile() {
      return signedIn() &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.email is string &&
        request.resource.data.role == 'user';
    }

    function isApprovedAuction() {
      return resource.data.status == 'approved';
    }

    function isAuctionSeller() {
      return signedIn() && resource.data.sellerId == request.auth.uid;
    }

    function createsOwnAuctionRequest() {
      return signedIn() &&
        request.resource.data.sellerId == request.auth.uid &&
        request.resource.data.status == 'pending' &&
        request.resource.data.state == 'PENDING';
    }

    function updatesBidPriceOnly() {
      return signedIn() &&
        resource.data.status == 'approved' &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['currentPrice', 'updatedAt']) &&
        request.resource.data.currentPrice is number &&
        request.resource.data.currentPrice > resource.data.currentPrice;
    }

    match /users/{userId} {
      allow create: if isOwner(userId) &&
        (isUserProfile() || isBootstrapAdminProfile());
      allow read: if isOwner(userId) || isAdmin();
      allow update: if isOwner(userId) &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['fullName', 'phone', 'aadhaar', 'pan', 'dob', 'userType']) &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.uid == resource.data.uid;
      allow update, delete: if isAdmin();
    }

    match /auction_requests/{requestId} {
      allow create: if createsOwnAuctionRequest();
      allow read: if isAdmin() ||
        (signedIn() && resource.data.sellerId == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    match /auctions/{auctionId} {
      allow read: if isAdmin() || isAuctionSeller() || isApprovedAuction();
      allow update: if isAdmin() || updatesBidPriceOnly();
      allow create, delete: if isAdmin();
    }

    match /complaints/{complaintId} {
      allow create: if signedIn();
      allow read, update, delete: if isAdmin();
    }

    match /payments/{paymentId} {
      allow create: if signedIn();
      allow read, update, delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
