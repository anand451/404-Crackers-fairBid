rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userExists(uid) {
      return exists(/databases/$(database)/documents/users/$(uid));
    }

    function userDoc(uid) {
      return get(/databases/$(database)/documents/users/$(uid));
    }

    function auctionExists(auctionId) {
      return exists(/databases/$(database)/documents/auctions/$(auctionId));
    }

    function auctionDoc(auctionId) {
      return get(/databases/$(database)/documents/auctions/$(auctionId));
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function hasProfile() {
      return signedIn() && userExists(request.auth.uid);
    }

    function isActiveAccount() {
      return hasProfile() && userDoc(request.auth.uid).data.status != 'blocked';
    }

    function isAdmin() {
      return isActiveAccount() &&
        userDoc(request.auth.uid).data.role == 'admin';
    }

    function isBootstrapAdminProfile() {
      return signedIn() &&
        request.auth.token.email == 'admin@gmail.com' &&
        request.resource.data.role == 'admin' &&
        request.resource.data.status == 'active';
    }

    function isUserProfile() {
      return signedIn() &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.email is string &&
        request.resource.data.role == 'user' &&
        request.resource.data.status == 'active';
    }

    function isApprovedAuction() {
      return resource.data.status == 'approved';
    }

    function isAuctionSeller() {
      return signedIn() && resource.data.sellerId == request.auth.uid;
    }

    function createsOwnAuctionRequest() {
      return isActiveAccount() &&
        (request.resource.data.sellerId == request.auth.uid ||
          request.resource.data.createdBy == request.auth.uid) &&
        request.resource.data.status == 'pending' &&
        request.resource.data.state == 'PENDING' &&
        request.resource.data.upiId is string;
    }

    function isPendingRequestOwner() {
      return isActiveAccount() &&
        resource.data.status == 'pending' &&
        (resource.data.sellerId == request.auth.uid ||
          resource.data.createdBy == request.auth.uid);
    }

    function sellerRunsAuctionLifecycle() {
      return isActiveAccount() &&
        resource.data.sellerId == request.auth.uid &&
        request.resource.data.sellerId == resource.data.sellerId &&
        request.resource.data.status == resource.data.status &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly([
            'state',
            'startTime',
            'endTime',
            'startedAt',
            'pausedAt',
            'soldAt',
            'endedAt',
            'updatedAt',
            'remainingSeconds',
            'winnerId',
            'winnerName',
            'highestBidId',
            'highestBidderId',
            'highestBidderName',
            'finalPrice',
            'paymentStatus',
            'paymentId',
            'currentPrice',
            'bidCount'
          ]);
    }

    function createsOwnAuctionReminderNotification() {
      return isActiveAccount() &&
        request.resource.data.receiverId == request.auth.uid &&
        request.resource.data.type == 'auction';
    }

    function createsComplaintNotificationForAdmin() {
      return isActiveAccount() &&
        request.resource.data.receiverRole == 'admin' &&
        request.resource.data.type == 'complaint' &&
        request.resource.data.senderId == request.auth.uid;
    }

    function createsSellerAuctionNotification() {
      return isActiveAccount() &&
        request.resource.data.type in ['auction', 'payment'] &&
        request.resource.data.senderId == request.auth.uid &&
        request.resource.data.auctionId is string &&
        auctionExists(request.resource.data.auctionId) &&
        auctionDoc(request.resource.data.auctionId).data.sellerId ==
          request.auth.uid;
    }

    function createsWinnerPaymentNotification() {
      return isActiveAccount() &&
        request.resource.data.type == 'payment' &&
        request.resource.data.senderId == request.auth.uid &&
        request.resource.data.auctionId is string &&
        auctionExists(request.resource.data.auctionId) &&
        auctionDoc(request.resource.data.auctionId).data.winnerId ==
          request.auth.uid;
    }

    function marksOwnNotificationRead() {
      return signedIn() &&
        resource.data.receiverId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['readStatus', 'readAt']) &&
        request.resource.data.readStatus == true;
    }

    function marksAdminNotificationRead() {
      return isAdmin() &&
        resource.data.receiverRole == 'admin' &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['readStatus', 'readAt']) &&
        request.resource.data.readStatus == true;
    }

    function validWinnerPayment() {
      return isActiveAccount() &&
        request.resource.data.auctionId is string &&
        auctionExists(request.resource.data.auctionId) &&
        auctionDoc(request.resource.data.auctionId).data.state == 'SOLD' &&
        auctionDoc(request.resource.data.auctionId).data.winnerId ==
          request.auth.uid &&
        request.resource.data.buyerId == request.auth.uid &&
        request.resource.data.sellerId ==
          auctionDoc(request.resource.data.auctionId).data.sellerId &&
        request.resource.data.amount ==
          auctionDoc(request.resource.data.auctionId).data.finalPrice &&
        request.resource.data.status == 'completed';
    }

    match /users/{userId} {
      allow create: if isOwner(userId) &&
        (isUserProfile() || isBootstrapAdminProfile());
      allow read: if isOwner(userId) || isAdmin();
      allow update: if isOwner(userId) &&
        isActiveAccount() &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly([
            'fullName',
            'phone',
            'aadhaar',
            'pan',
            'dob',
            'userType',
            'reminderAuctions',
            'updatedAt'
          ]) &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.status == resource.data.status &&
        request.resource.data.uid == resource.data.uid;
      allow update, delete: if isAdmin();
    }

    match /auction_requests/{requestId} {
      allow create: if createsOwnAuctionRequest();
      allow read: if isAdmin() ||
        (signedIn() &&
          (resource.data.sellerId == request.auth.uid ||
            resource.data.createdBy == request.auth.uid));
      allow update: if isAdmin() ||
        (isPendingRequestOwner() &&
          request.resource.data.status == 'pending' &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly([
              'auctionId',
              'id',
              'title',
              'description',
              'category',
              'currentPrice',
              'reservePrice',
              'price',
              'startTime',
              'duration',
              'durationHours',
              'endTime',
              'location',
              'upiId',
              'remainingSeconds',
              'updatedAt'
            ]));
      allow delete: if isAdmin() || isPendingRequestOwner();
    }

    match /auctions/{auctionId} {
      allow read: if isAdmin() || isAuctionSeller() || isApprovedAuction();
      allow update: if isAdmin() || sellerRunsAuctionLifecycle();
      allow create: if isAdmin();
      allow delete: if isAdmin() || isAuctionSeller();

      match /bids/{bidId} {
        allow read: if isAdmin() ||
          (auctionExists(auctionId) &&
            (auctionDoc(auctionId).data.status == 'approved' ||
              auctionDoc(auctionId).data.sellerId == request.auth.uid));
        allow create: if isActiveAccount() &&
          request.resource.data.userId == request.auth.uid &&
          request.resource.data.bidAmount is number &&
          auctionExists(auctionId) &&
          auctionDoc(auctionId).data.status == 'approved' &&
          auctionDoc(auctionId).data.state == 'LIVE' &&
          auctionDoc(auctionId).data.sellerId != request.auth.uid &&
          request.resource.data.bidAmount >
            auctionDoc(auctionId).data.currentPrice;
        allow update, delete: if false;
      }
    }

    match /auction_watchers/{auctionId}/members/{userId} {
      allow read: if isAdmin() ||
        (auctionExists(auctionId) &&
          (auctionDoc(auctionId).data.status == 'approved' ||
            auctionDoc(auctionId).data.sellerId == request.auth.uid));
      allow create, update: if isActiveAccount() &&
        request.auth.uid == userId &&
        request.resource.data.userId == request.auth.uid;
      allow delete: if isActiveAccount() && request.auth.uid == userId;
    }

    match /likes/{reactionId} {
      allow read: if true;
      allow create, update: if isActiveAccount() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.auctionId is string &&
        request.resource.data.value in ['like', 'dislike'];
      allow delete: if isActiveAccount() &&
        resource.data.userId == request.auth.uid;
    }

    match /notifications/{notificationId} {
      allow create: if isAdmin() ||
        createsOwnAuctionReminderNotification() ||
        createsComplaintNotificationForAdmin() ||
        createsSellerAuctionNotification() ||
        createsWinnerPaymentNotification();
      allow read: if isAdmin() ||
        (signedIn() && resource.data.receiverId == request.auth.uid);
      allow update: if isAdmin() || marksOwnNotificationRead() ||
        marksAdminNotificationRead();
      allow delete: if isAdmin() ||
        (isActiveAccount() &&
          resource.data.receiverId == request.auth.uid &&
          resource.data.type in ['auction', 'payment']);
    }

    match /chats/{chatId} {
      allow create, update: if isActiveAccount() &&
        request.auth.uid in request.resource.data.participants;
      allow read: if signedIn() &&
        request.auth.uid in resource.data.participants;

      match /messages/{messageId} {
        allow read: if signedIn() &&
          request.auth.uid in
            get(/databases/$(database)/documents/chats/$(chatId))
              .data.participants;
        allow create: if isActiveAccount() &&
          request.auth.uid in
            get(/databases/$(database)/documents/chats/$(chatId))
              .data.participants;
      }
    }

    match /complaints/{complaintId} {
      allow create: if isActiveAccount() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.status == 'pending';
      allow read: if isAdmin() ||
        (signedIn() && resource.data.userId == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    match /payments/{paymentId} {
      allow create: if validWinnerPayment();
      allow read: if isAdmin() ||
        (signedIn() &&
          (resource.data.buyerId == request.auth.uid ||
            resource.data.sellerId == request.auth.uid));
      allow update, delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
